<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>ForjaLivre</RootNamespace>
    <AssemblyName>ForjaLivre</AssemblyName>

    <!-- Referencia o Harmony na mesma versão usada pelo SMAPI, para evitar conflitos. -->
    <EnableHarmony>true</EnableHarmony>

    <!-- Caminho do jogo neste computador (evita depender da auto-detecção). -->
    <GamePath>/home/jonathan/.local/share/Steam/steamapps/common/Stardew Valley</GamePath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Pathoschild.Stardew.ModBuildConfig" Version="4.4.0" />
  </ItemGroup>

</Project>
